# 复制本文件为 keystore.properties 并填入你自己的签名信息。
# ⚠️ keystore.properties 与 .keystore/.jks 都已在 .gitignore 里,不要提交。
# 没有这个文件时,release 包会用工程自带的调试签名编译(能装能跑,但不适合发布)。
#
# 生成你自己的 keystore:
#   keytool -genkeypair -v -keystore my-release.keystore -alias mykey \
#     -keyalg RSA -keysize 2048 -validity 10950
storeFile=_env/release.keystore
storePassword=改成你的口令
keyAlias=schedule
keyPassword=改成你的口令
